<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
    <title>404 | Muse</title>
    <style>
      html,
      body{
        min-height: 100%;
      }

      body{
        margin: 0;
        font-family: "Sora", "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        color: var(--text);
        background:
          radial-gradient(900px 500px at 8% -10%, rgb(6 182 212 / 0.16) 0%, transparent 70%),
          radial-gradient(1000px 580px at 100% 0%, rgb(236 72 153 / 0.22) 0%, transparent 70%),
          linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 100%);
        overflow-x: hidden;
      }

      .sky{
        position: fixed;
        inset: 0;
        pointer-events: none;
      }

      .sky::before,
      .sky::after{
        content: "";
        position: absolute;
        inset: 0;
        background-repeat: repeat;
        background-size: 220px 220px;
        animation: drift 24s linear infinite;
      }

      .sky::before{
        opacity: 0.35;
        background-image:
          radial-gradient(circle at 15% 25%, rgb(196 208 236 / 0.75) 0 1px, transparent 1px),
          radial-gradient(circle at 45% 75%, rgb(6 182 212 / 0.5) 0 1px, transparent 1px),
          radial-gradient(circle at 80% 35%, rgb(236 72 153 / 0.55) 0 1px, transparent 1px);
      }

      .sky::after{
        opacity: 0.2;
        background-image:
          radial-gradient(circle at 25% 55%, rgb(248 250 252 / 0.65) 0 1px, transparent 1px),
          radial-gradient(circle at 70% 15%, rgb(139 92 246 / 0.55) 0 1px, transparent 1px),
          radial-gradient(circle at 60% 85%, rgb(6 182 212 / 0.5) 0 1px, transparent 1px);
        animation-duration: 38s;
        animation-direction: reverse;
      }

      main{
        min-height: 100vh;
        width: min(72rem, calc(100% - 2.5rem));
        margin-inline: auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        align-items: center;
        gap: clamp(1.5rem, 4vw, 3rem);
        padding-block: clamp(2rem, 6vw, 4rem);
        position: relative;
        z-index: 1;
      }

      .copy h1{
        margin: 0 0 1rem;
        font-size: clamp(3rem, 8vw, 6rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
        color: color-mix(in hsl shorter hue, var(--pink) 60%, var(--violet) 40%);
      }

      .copy p{
        margin: 0;
        max-width: 44ch;
        color: var(--muted);
        line-height: 1.65;
      }

      .actions{
        margin-top: 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .button{
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 0;
        border-radius: 0.85rem;
        padding: 0.82rem 1.05rem;
        text-decoration: none;
        font-weight: 700;
        color: #ffffff;
        transition: transform 120ms ease, filter 120ms ease;
      }

      .button.primary{
        background: linear-gradient(120deg, var(--pink) 0%, var(--violet) 100%);
        box-shadow: 0 10px 30px rgb(139 92 246 / 0.35);
      }

      .button.secondary{
        background: linear-gradient(145deg, rgb(24 39 72 / 0.6) 0%, rgb(16 27 52 / 0.35) 100%);
        border: 1px solid color-mix(in hsl shorter hue, var(--violet) 35%, #ffffff 65%);
      }

      .button:hover{
        transform: translateY(-1px);
        filter: brightness(1.07);
      }

      .art{
        position: relative;
        height: min(72vw, 32rem);
      }

      .ring{
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
      }

      .ring.one{
        width: 88%;
        aspect-ratio: 1;
        border: 1px solid rgb(139 92 246 / 0.32);
        box-shadow: inset 0 0 80px rgb(17 27 52 / 0.65);
        animation: spin 22s linear infinite;
      }

      .ring.two{
        width: 66%;
        aspect-ratio: 1;
        border: 1px dashed rgb(6 182 212 / 0.45);
        animation: spin 16s linear infinite reverse;
      }

      .ring.three{
        width: 40%;
        aspect-ratio: 1;
        background:
          radial-gradient(circle at 30% 28%, rgb(248 250 252 / 0.8) 0 2px, transparent 2px),
          radial-gradient(circle at 66% 65%, rgb(236 72 153 / 0.55) 0 3px, transparent 3px),
          linear-gradient(145deg, rgb(23 36 69 / 0.95) 0%, rgb(17 27 52 / 1) 100%);
        border: 1px solid rgb(236 72 153 / 0.32);
        box-shadow: 0 20px 60px rgb(2 6 23 / 0.55);
      }

      .digit{
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        font-size: clamp(4rem, 12vw, 7.5rem);
        font-weight: 700;
        letter-spacing: -0.06em;
        text-shadow: 0 16px 50px rgb(2 6 23 / 0.75);
      }

      .digit.left{
        left: 7%;
        color: rgb(6 182 212 / 0.88);
      }

      .digit.right{
        right: 9%;
        color: rgb(236 72 153 / 0.9);
      }

      .pulse-line{
        position: absolute;
        left: 10%;
        right: 10%;
        bottom: 8%;
        height: 64px;
        border-radius: 0.9rem;
        border: 1px solid rgb(44 63 107 / 0.8);
        background: linear-gradient(145deg, rgb(17 27 52 / 0.85) 0%, rgb(15 23 42 / 0.4) 100%);
        overflow: hidden;
      }

      .bars{
        height: 100%;
        display: flex;
        align-items: end;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.65rem;
      }

      .bar{
        width: 7%;
        border-radius: 999px;
        background: linear-gradient(180deg, var(--cyan) 0%, var(--violet) 55%, var(--pink) 100%);
        animation: eq 1150ms ease-in-out infinite;
      }

      .bar:nth-child(2n){
        animation-duration: 950ms;
      }

      .bar:nth-child(3n){
        animation-duration: 1400ms;
      }

      .bar:nth-child(4n){
        animation-duration: 1000ms;
      }

      @keyframes eq{
        0%, 100%{ height: 18%; }
        35%{ height: 92%; }
        70%{ height: 45%; }
      }

      @keyframes spin{
        from{ transform: translate(-50%, -50%) rotate(0deg); }
        to{ transform: translate(-50%, -50%) rotate(360deg); }
      }

      @keyframes drift{
        from{ transform: translateY(0); }
        to{ transform: translateY(220px); }
      }

      @media (max-width: 900px){
        main{
          grid-template-columns: 1fr;
          text-align: center;
          width: min(35rem, calc(100% - 1.5rem));
        }

        .copy p{
          margin-inline: auto;
        }

        .actions{
          justify-content: center;
        }

        .art{
          order: -1;
          height: min(72vw, 22rem);
        }

        .digit.left{
          left: 10%;
        }

        .digit.right{
          right: 12%;
        }
      }
    </style>
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>
    <main>
      <section class="copy">
        <h1>404</h1>
        <p>
          The content you are looking for cannot be found. It might have been removed, had its name changed, or is temporarily unavailable.
        </p>
        <div class="actions">
          <a class="button primary" href="/">Back to Home</a>
          <a class="button secondary" href="/signup">Join Muse</a>
        </div>
      </section>
      <section class="art" aria-hidden="true">
        <span class="digit left">4</span>
        <span class="digit right">4</span>
        <div class="ring one"></div>
        <div class="ring two"></div>
        <div class="ring three"></div>
      </section>
    </main>
  </body>
</html>
