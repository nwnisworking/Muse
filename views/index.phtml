<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href="css/style.css" />
		<title>Muse - Peer to Peer Audio Sharing</title>
	</head>
	<body>
		<nav>
			<a class="brand" href="#" aria-label="Muse home">
				<img src="assets/logo.svg" alt="Muse logo" />
				<span>Muse</span>
			</a>
			<button>Sign In</button>
		</nav>
		<header>
			<section class="hero">
				<aside>
					<h1>Share tracks, discover music, and connect through peer-to-peer listening.</h1>
					<p>Muse lets listeners exchange audio directly with each other through private circles and open communities, making peer-to-peer sharing simple, fast, and accessible on any device.</p>
					<form action="#" method="post">
						<input id="email" name="email" type="email" placeholder="Enter your email" autocomplete="email" />
						<button type="submit">Sign Up Now</button>
					</form>
				</aside>
			</section>
		</header>
	</body>
</html>